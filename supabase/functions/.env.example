SEORAP_ENV=local
SEORAP_HMAC_KEY=
SEORAP_ENC_KEY_A=
SEORAP_ENC_KEY_B=
SEORAP_COOKIE_SECURE=false
SEORAP_PUBLIC_BASE=http://localhost:5173
SEORAP_PLATFORM_TEST_URL=https://inpsyt.co.kr/inpsyt/testing
# DB 접속 비밀키(새 방식 sb_secret_…). 로컬은 `supabase status -o env`의 SECRET_KEY, 미리보기·운영은 대시보드 API Keys의 secret key.
SEORAP_DB_SECRET_KEY=
# 미리보기만: /dev/outbox 를 여는 키(gen-keys.ts preview 가 만든다). 로컬은 확인하지 않고, 운영은 키와 상관없이 닫힌다.
SEORAP_DEV_OUTBOX_KEY=
