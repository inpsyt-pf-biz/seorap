# 화면(브라우저)에 들어가는 값. 공개돼도 되는 값만.
# Vercel: Production = seorap 프로젝트 값, Preview = seorap-preview 프로젝트 값
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# local | preview | production. local·preview일 때만 /dev/outbox 화면이 빌드에 들어간다.
# 비워 두면 들어가지 않는다(안전한 쪽). 운영 도메인 연결 시 Production은 production으로.
VITE_SEORAP_ENV=
# 미리보기(Preview)만: 함수 비밀값 SEORAP_DEV_OUTBOX_KEY 와 같은 값. /dev/outbox 화면이 X-Seorap-Dev-Key 머리글로 보낸다.
# 운영(Production)에는 절대 넣지 않는다. 로컬은 비워 둔다(로컬 함수는 키를 확인하지 않는다).
VITE_SEORAP_DEV_OUTBOX_KEY=
